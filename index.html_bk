<!DOCTYPE html>
<html lang="pt-BR">
<head><script src="https://myhub.ia.br/canvas-vendor/tailwind.js"></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Refloresta Vinhedo | Coletivo de Plantio</title>
<style>
html{scroll-behavior:smooth}
.hero{background:linear-gradient(rgba(10,40,20,.65),rgba(10,40,20,.75)),url('https://images.unsplash.com/photo-1448375240586-882707db888b?w=1600') center/cover}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 1.2s ease,transform 1.2s ease}
.reveal.show{opacity:1;transform:none}
.card.reveal, #princ .reveal{transition:opacity .8s ease, transform .8s ease, box-shadow .3s, border-color .3s}
.card.pronto, #princ .pronto{transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease, opacity .25s;transition-delay:0s!important}
.missao{position:relative;color:#fff;background:linear-gradient(90deg,rgba(8,30,16,.92) 0%,rgba(8,30,16,.7) 45%,rgba(8,30,16,.25) 100%),linear-gradient(0deg,rgba(8,30,16,.85) 0%,rgba(8,30,16,0) 45%),url('https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=1800') center/cover no-repeat}
.m-icone{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:9999px;border:1.5px solid rgba(163,230,53,.6);background:rgba(163,230,53,.1);color:#a3e635}
.m-serif{font-family:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif}
.m-display{font-size:clamp(2.4rem,5vw,3.6rem);line-height:1.05;font-weight:600;letter-spacing:-.01em;text-wrap:balance}
.missao h3{text-wrap:balance}
.missao p{text-wrap:pretty}
.m-lead{font-size:clamp(1.25rem,2.2vw,1.6rem);line-height:1.45;max-width:34ch}
.m-corpo{max-width:62ch;line-height:1.7}
.m-terra{border-left:3px solid #3f6b2a;padding-left:1.25rem}
.m-agua{border-left:3px solid #2f6f8f;padding-left:1.25rem}
.m-frase{font-size:clamp(1.6rem,3.4vw,2.6rem);line-height:1.3;max-width:26ch}
.m-num{font-variant-numeric:tabular-nums;font-weight:700;color:#3f6b2a}
.m-ramo path{stroke-dasharray:600;stroke-dashoffset:600;transition:stroke-dashoffset 2.4s ease}
.reveal.show .m-ramo path{stroke-dashoffset:0}
@media (prefers-reduced-motion:reduce){
 #missao .reveal{opacity:1;transform:none;transition:none}
 .m-ramo path{stroke-dashoffset:0;transition:none}
}
.hero{background-attachment:fixed;position:relative;overflow:hidden}

@keyframes grad{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.grad{background:linear-gradient(90deg,#a3e635,#4ade80,#facc15,#a3e635);background-size:300%;-webkit-background-clip:text;color:transparent;animation:grad 6s ease infinite}
#palavra{display:inline-block;transition:all .5s}
#palavra.sai{opacity:0;transform:translateY(-20px)}
@keyframes pulse2{0%,100%{box-shadow:0 0 0 0 rgba(163,230,53,.5)}50%{box-shadow:0 0 0 13px rgba(163,230,53,0)}}
.pulsa{animation:pulse2 4s ease-in-out infinite}
@keyframes marquee{to{transform:translateX(-50%)}}
.marquee{display:flex;width:max-content;animation:marquee 35s linear infinite}
.card img{transition:transform .6s}
.card:hover img{transform:scale(1.12)}
#progresso{position:fixed;top:0;left:0;height:4px;background:#a3e635;z-index:60;width:0}
header.scrolled{box-shadow:0 4px 20px rgba(0,0,0,.3)}
header nav{transition:padding .3s}
header.scrolled nav{padding-top:.6rem;padding-bottom:.6rem}
@keyframes bounce2{0%,100%{transform:translateY(0)}50%{transform:translateY(10px)}}
.seta{animation:bounce2 1.5s infinite}
.obj{position:relative;overflow:hidden;display:flex;flex-direction:column;background:#fff;border:1px solid #e7e5e4;border-radius:1.5rem;padding:2rem 1.75rem 1.75rem}
.obj:hover{transform:translateY(-8px);box-shadow:0 20px 40px -12px rgba(20,83,45,.25);border-color:#a3e635}

.obj-ico{position:relative;display:flex;align-items:center;justify-content:center;width:60px;height:60px;border-radius:1rem;font-size:1.75rem;margin-bottom:1.25rem;background:transparent;border:1.5px solid #65a30d;transition:transform .4s}

.pr{position:relative;display:flex;flex-direction:column;background:linear-gradient(160deg,rgba(20,83,45,.55),rgba(5,46,22,.6));border:1px solid rgba(163,230,53,.18);border-radius:1.5rem;padding:1.75rem}
.pr:hover{transform:translateY(-8px)}
.pr-ico{display:flex;align-items:center;justify-content:center;width:52px;height:52px;font-size:1.6rem;margin-bottom:1.1rem;border-radius:.875rem;border:1.5px solid rgba(163,230,53,.6);background:rgba(163,230,53,.1)}
.obj-tag{align-self:flex-start;margin-top:1.25rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#166534;background:#f0fdf4;border:1px solid #bbf7d0;padding:.3rem .75rem;border-radius:9999px}
</style>
</head>
<body class="font-sans text-gray-800 bg-stone-50">
<div id="progresso"></div>

<header class="fixed w-full z-50 bg-green-950/90 backdrop-blur text-white">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="#inicio" class="text-xl font-extrabold tracking-wide">🌳 REFLORESTA <span class="text-lime-400">VINHEDO</span></a>
    <button id="menuBtn" class="md:hidden text-2xl">☰</button>
    <ul id="menu" class="hidden md:flex gap-6 text-sm font-medium">
      <li><a href="#quem-somos" class="hover:text-lime-400">Quem Somos</a></li>
      <li><a href="#missao" class="hover:text-lime-400">Missão</a></li>
      <li><a href="#acoes" class="hover:text-lime-400">Ações</a></li>
      <li><a href="#principios" class="hover:text-lime-400">Princípios</a></li>
      <li><a href="#contato" class="bg-lime-500 text-green-950 px-4 py-2 rounded-full hover:bg-lime-400">Participe</a></li>
    </ul>
  </nav>
  <ul id="mobile" class="hidden md:hidden flex-col px-6 pb-4 gap-3 text-sm">
    <li><a href="#quem-somos">Quem Somos</a></li><li><a href="#missao">Missão</a></li>
    <li><a href="#acoes">Ações</a></li><li><a href="#principios">Princípios</a></li><li><a href="#contato">Participe</a></li>
  </ul>
</header>

<section id="inicio" class="hero min-h-screen flex items-center text-white">
  <div class="max-w-6xl mx-auto px-6 pt-24">
    <p class="uppercase tracking-[.3em] text-lime-400 text-sm mb-4">Plantando a Mudança</p>
    <h1 class="text-4xl md:text-6xl font-extrabold leading-tight max-w-3xl">Muda a muda,<br>uma nova <span id="palavra" class="grad">cidade.</span></h1>
    <p class="mt-6 max-w-2xl text-lg text-gray-200">Somos um coletivo de pessoas comuns, moradores de Vinhedo, unidos para recuperar áreas, regenerar o verde e proteger as nascentes de um território que já perdeu <strong class="text-lime-400">47% da Mata Atlântica</strong> desde 2004.</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#contato" class="pulsa bg-lime-500 text-green-950 font-bold px-6 py-3 rounded-full hover:bg-lime-400 hover:scale-105 transition">Seja voluntário</a>
      <a href="#acoes" class="border border-white px-6 py-3 rounded-full hover:bg-white hover:text-green-950 transition">Conheça nossas ações</a>
    </div>
  </div>
  <a href="#quem-somos" class="seta absolute bottom-8 left-1/2 -translate-x-1/2 text-3xl text-lime-400">⌄</a>
</section>

<section class="bg-green-900 text-white py-12">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    <div><p class="text-4xl font-extrabold text-lime-400 counter" data-to="1000">0</p><p class="text-sm">árvores nativas plantadas</p></div>
    <div><p class="text-4xl font-extrabold text-lime-400 counter" data-to="1000">0</p><p class="text-sm">alunos atendidos</p></div>
    <div><p class="text-4xl font-extrabold text-lime-400 counter" data-to="50">0</p><p class="text-sm">projetos executados</p></div>
    <div><p class="text-4xl font-extrabold text-lime-400">2021</p><p class="text-sm">ano de fundação</p></div>
  </div>
</section>

<div class="bg-lime-400 text-green-950 py-3 overflow-hidden font-bold uppercase tracking-widest text-sm">
  <div class="marquee" id="mq"></div>
</div>

<section id="quem-somos" class="py-24 bg-stone-50 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-12 items-center reveal">
      <div class="lg:col-span-5 relative">
        <div class="absolute -top-4 -left-4 w-full h-full rounded-3xl border-2 border-lime-400"></div>
        <img src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=900" alt="Voluntários plantando mudas" class="relative rounded-3xl shadow-2xl w-full h-[460px] object-cover">
        <div class="absolute -bottom-6 -right-4 bg-green-900 text-white rounded-2xl px-6 py-4 shadow-xl">
          <p class="text-xs uppercase tracking-widest text-lime-400">Desde</p>
          <p class="text-3xl font-extrabold">2021</p>
        </div>
      </div>
      <div class="lg:col-span-7">
        <p class="text-green-700 text-sm font-semibold uppercase tracking-[.3em] mb-4">Quem somos</p>
        <h2 class="text-3xl md:text-5xl font-extrabold text-green-950 leading-tight" style="text-wrap:balance">Gente comum, unida por um <span class="text-green-600">mesmo propósito.</span></h2>
        <p class="mt-6 text-lg text-gray-600 leading-relaxed max-w-xl">Somos pessoas de diferentes origens, formações e histórias que compartilham um mesmo desejo: <strong class="text-green-900">agir</strong> pela regeneração do nosso território.</p>
        <figure class="mt-8 relative bg-white rounded-2xl p-6 pl-14 shadow-md border border-stone-200">
          <span class="absolute left-4 top-2 text-6xl text-lime-400 font-serif leading-none" aria-hidden="true">“</span>
          <blockquote class="italic text-gray-700 leading-relaxed">A cultura regenerativa caminha junto com a consciência de que as comunidades são corresponsáveis pelo seu território e constrói novas realidades a partir da inteligência coletiva.</blockquote>
        </figure>
      </div>
    </div>

    <div class="mt-24 mb-10 text-center reveal">
      <p class="text-green-700 text-sm font-semibold uppercase tracking-[.3em] mb-3">O que nos move</p>
      <h3 class="text-2xl md:text-4xl font-extrabold text-green-950">Nossos objetivos comuns</h3>
      <span class="block w-16 h-1 bg-lime-400 rounded-full mx-auto mt-4"></span>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card reveal obj group">
        <span class="obj-ico">🌱</span>
        <h4 class="text-xl font-extrabold text-green-950 mb-2">Reflorestar</h4>
        <p class="text-sm text-gray-600 leading-relaxed flex-1">Recuperar a flora e a fauna da Mata Atlântica com espécies nativas da nossa região.</p>
        <span class="obj-tag">Mata Atlântica</span>
      </div>
      <div class="card reveal obj group">
        <span class="obj-ico">💧</span>
        <h4 class="text-xl font-extrabold text-green-950 mb-2">Revitalizar</h4>
        <p class="text-sm text-gray-600 leading-relaxed flex-1">Recuperar as nascentes e ampliar as áreas protegidas ao redor delas.</p>
        <span class="obj-tag">Nascentes</span>
      </div>
      <div class="card reveal obj group">
        <span class="obj-ico">🤝</span>
        <h4 class="text-xl font-extrabold text-green-950 mb-2">Apoiar</h4>
        <p class="text-sm text-gray-600 leading-relaxed flex-1">Apoiar projetos locais com os mesmos objetivos e aprender com eles.</p>
        <span class="obj-tag">Parcerias</span>
      </div>
      <div class="card reveal obj group">
        <span class="obj-ico">📚</span>
        <h4 class="text-xl font-extrabold text-green-950 mb-2">Conscientizar</h4>
        <p class="text-sm text-gray-600 leading-relaxed flex-1">Despertar nos moradores de Vinhedo a consciência ambiental e levá-los a agir.</p>
        <span class="obj-tag">Educação</span>
      </div>
    </div>

    <div class="mt-12 reveal flex flex-col md:flex-row items-center gap-6 bg-green-900 text-white rounded-3xl p-8">
      <span class="text-4xl" aria-hidden="true">💡</span>
      <p class="flex-1 text-gray-200"><strong class="text-lime-400">Como nascem nossas ações:</strong> as ideias são discutidas e ajustadas pelo grupo, os voluntários as colocam em prática e nós documentamos e divulgamos os resultados.</p>
      <a href="#contato" class="shrink-0 bg-lime-500 text-green-950 font-bold px-6 py-3 rounded-full hover:bg-lime-400 transition">Quero participar</a>
    </div>
  </div>
</section>

<section id="missao" aria-labelledby="missao-titulo" class="missao py-28 md:py-36 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl reveal">
      <p class="text-lime-400 text-sm font-semibold uppercase tracking-[.3em] mb-5">Nossa missão</p>
      <h2 id="missao-titulo" class="text-4xl md:text-6xl font-extrabold leading-[1.08]" style="text-wrap:balance">Restaurar o hoje para um amanhã <span class="text-lime-400">mais verde.</span></h2>
      <p class="mt-6 text-lg text-gray-200 max-w-xl leading-relaxed">Somos um coletivo criado em 2021 por pessoas que amam o território de <span translate="no">Vinhedo</span> e região.</p>
      <p class="mt-4 text-gray-300 max-w-xl leading-relaxed">Nossa cidade, antes desejada pela qualidade de vida e pelo verde, sofre com um crescimento imobiliário que ignora as recomendações de áreas verdes da ONU e a proteção das águas. Ao mesmo tempo, temos um dos menores índices de chuva da região, o que pressiona a disponibilidade de água por habitante.</p>
      <p class="mt-4 text-gray-300 max-w-xl leading-relaxed">Por isso, além de ativistas, colocamos a mão na massa: plantamos nativas da Mata Atlântica e do Cerradão, protegemos nascentes, lutamos por políticas públicas e unidades de conservação e levamos educação ambiental às escolas.</p>
    </div>

    <ul role="list" class="mt-16 grid sm:grid-cols-3 gap-10 max-w-4xl reveal">
      <li class="flex gap-4 items-start min-w-0">
        <span class="m-icone" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21c0-9 5-15 15-16-1 10-7 15-15 16z"/><path d="M5 21l8-8"/></svg></span>
        <div class="min-w-0 break-words"><h3 class="font-bold text-lg text-lime-400">Recuperar</h3><p class="text-sm text-gray-200">+1.000 árvores nativas plantadas em áreas degradadas.</p></div>
      </li>
      <li class="flex gap-4 items-start min-w-0">
        <span class="m-icone" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/></svg></span>
        <div class="min-w-0 break-words"><h3 class="font-bold text-lg text-lime-400">Proteger</h3><p class="text-sm text-gray-200">as nascentes e as águas do nosso território.</p></div>
      </li>
      <li class="flex gap-4 items-start min-w-0">
        <span class="m-icone" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3"/><circle cx="5" cy="9" r="2.2"/><circle cx="19" cy="9" r="2.2"/><path d="M7 20v-2a5 5 0 0 1 10 0v2"/><path d="M2 19v-1a3 3 0 0 1 4-2.8"/><path d="M22 19v-1a3 3 0 0 0-4-2.8"/></svg></span>
        <div class="min-w-0 break-words"><h3 class="font-bold text-lg text-lime-400">Educar</h3><p class="text-sm text-gray-200">+1.000 alunos atendidos, deixando um legado verde.</p></div>
      </li>
    </ul>
  </div>
</section>

<section id="acoes" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-extrabold text-green-900 text-center mb-12 reveal">O que fazemos</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:-translate-y-2 hover:shadow-2xl transition card reveal">
        <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600" class="h-48 w-full object-cover" alt="">
        <div class="p-6"><h3 class="font-bold text-xl text-green-800 mb-2">Plantio de Mudas</h3>
        <p class="text-sm">Mutirões em condomínios (TAC, compensação, recuperação de áreas degradadas), calçadas e áreas rurais para recuperar APPs e reservas legais.</p></div>
      </div>
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:-translate-y-2 hover:shadow-2xl transition card reveal">
        <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=600" class="h-48 w-full object-cover" alt="">
        <div class="p-6"><h3 class="font-bold text-xl text-green-800 mb-2">Ações Educativas</h3>
        <p class="text-sm">Plantios orientados em escolas públicas e privadas, com educação ambiental ao ar livre e criação de <strong>florestas de bolso</strong>.</p></div>
      </div>
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:-translate-y-2 hover:shadow-2xl transition card reveal">
        <img src="https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=600" class="h-48 w-full object-cover" alt="">
        <div class="p-6"><h3 class="font-bold text-xl text-green-800 mb-2">Nascentes</h3>
        <p class="text-sm">Recuperação de nascentes em áreas particulares, condominiais e públicas, com apoio da municipalidade. A árvore é a verdadeira <strong>fábrica de água</strong>.</p></div>
      </div>
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:-translate-y-2 hover:shadow-2xl transition card reveal">
        <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600" class="h-48 w-full object-cover" alt="Floresta">
        <div class="p-6"><h3 class="font-bold text-xl text-green-800 mb-2">Troca de Saberes</h3>
        <p class="text-sm">Apaixonados por fauna e flora, sonhamos com a integração do urbano com o verde e com um desenvolvimento <strong>centrado no planeta</strong>. Em nossos canais digitais e em encontros presenciais, trocamos saberes e nos inspiramos para as próximas ações.</p>
        <p class="text-sm mt-3 italic text-green-700">"A natureza é nossa inspiração, nossa mentora e nossa métrica."</p></div>
      </div>
    </div>
  </div>
</section>

<section id="principios" class="py-24 bg-green-950 text-white scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14 reveal">
      <p class="text-lime-400 text-sm font-semibold uppercase tracking-[.3em] mb-3">No que acreditamos</p>
      <h2 class="text-3xl md:text-5xl font-extrabold" style="text-wrap:balance">Nossos <span class="text-lime-400">princípios</span></h2>
      <span class="block w-16 h-1 bg-lime-400 rounded-full mx-auto mt-4"></span>
      <p class="mt-6 text-gray-300 max-w-2xl mx-auto leading-relaxed">Os valores que guiam cada plantio, cada encontro e cada decisão do coletivo.</p>
    </div>
    <div id="princ" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>
  </div>
</section>

<section id="contato" class="py-20">
  <div class="max-w-3xl mx-auto px-6 text-center reveal">
    <h2 class="text-3xl font-extrabold text-green-900 mb-3">Junte-se a nós</h2>
    <p class="mb-8">O mundo precisa plantar 1 trilhão de árvores. <strong>Vinhedo, 1 milhão.</strong></p>
    <form id="form" class="grid gap-4 text-left bg-white p-8 rounded-2xl shadow-lg">
      <input required placeholder="Seu nome" class="border rounded-lg p-3">
      <input required type="email" placeholder="Seu e-mail" class="border rounded-lg p-3">
      <select class="border rounded-lg p-3"><option>Quero ser voluntário</option><option>Quero um plantio na minha escola</option><option>Quero um plantio no meu condomínio</option><option>Outro assunto</option></select>
      <textarea rows="4" placeholder="Mensagem" class="border rounded-lg p-3"></textarea>
      <button class="bg-green-800 text-white font-bold py-3 rounded-full hover:bg-green-700">Enviar</button>
      <p id="ok" class="hidden text-center text-green-700 font-semibold">Obrigado! Entraremos em contato. 🌱</p>
    </form>
  </div>
</section>

<footer class="bg-green-900 text-gray-200 py-10 text-center text-sm">
  <p class="font-bold text-white text-lg mb-2">🌳 Refloresta Vinhedo</p>
  <p>Plantando a Mudança · <a href="mailto:reflorestavinhedo@gmail.com" class="text-lime-400">reflorestavinhedo@gmail.com</a> · <a href="https://instagram.com/reflorestavinhedo" class="text-lime-400">@reflorestavinhedo</a></p>
  <p class="mt-4 text-gray-400">© 2026 Refloresta Vinhedo · Coletivo voluntário e independente</p>
</footer>

<script>
const p=[["🍃","Simples","Valorizamos toda ação alinhada aos nossos valores e práticas, por menor que seja."],["🌱","Concretos","Nada como plantar para sentir o gosto da MUDAnça. A pedagogia da ação nos transforma e nos inspira a ser exemplo."],["🔬","Reflexivos","Nossa prática se apoia na ciência e em referências globais, como o Acordo de Paris, o Estatuto da Cidade, a Economia Donut, a Economia Circular e a Biomimética."],["🫶","Inclusivos","Toda ação faz diferença. Valorizamos o que cada pessoa pode oferecer, porque a transformação acontece no dia a dia."],["🌈","Diversos","A diversidade nos fortalece: ideias diferentes geram novas soluções para futuros desejáveis."],["🤲","Pelo bem comum","Somos voluntários e não permitimos o uso do coletivo para benefícios privados, políticos ou econômicos."],["🧭","Independentes","Apoiamos políticas públicas ambientais alinhadas aos nossos princípios, preservando a autonomia de pensar e agir."],["♻️","Regenerativos","Cuidamos dos sistemas naturais e de toda a vida que eles sustentam."]];
document.getElementById('princ').innerHTML=p.map(x=>`<div class="pr"><span class="pr-ico" aria-hidden="true">${x[0]}</span><p class="text-xs uppercase tracking-[.2em] text-gray-400 mb-1">Somos</p><h3 class="text-xl font-extrabold text-lime-400 mb-3">${x[1]}</h3><p class="text-sm text-gray-300 leading-relaxed">${x[2]}</p></div>`).join('');
menuBtn.onclick=()=>{mobile.classList.toggle('hidden');mobile.classList.toggle('flex')};
document.querySelectorAll('#mobile a').forEach(a=>a.onclick=()=>{mobile.classList.add('hidden');mobile.classList.remove('flex')});
const io=new IntersectionObserver(e=>e.forEach(i=>{if(i.isIntersecting){i.target.classList.add('show');
 if(i.target.classList.contains('counter')){let t=+i.target.dataset.to,n=0,s=t/50;const f=setInterval(()=>{n+=s;if(n>=t){n=t;clearInterval(f)}i.target.textContent=(n>=t?'+':'')+Math.floor(n).toLocaleString('pt-BR')},25)}
 io.unobserve(i.target)}}),{threshold:.2});
document.querySelectorAll('.reveal,.counter').forEach(el=>io.observe(el));
form.onsubmit=e=>{e.preventDefault();ok.classList.remove('hidden');form.reset()};

// palavra rotativa
const palavras=['cidade.','floresta.','nascente.','história.','Vinhedo.'];let pi=0;
setInterval(()=>{palavra.classList.add('sai');setTimeout(()=>{pi=(pi+1)%palavras.length;palavra.textContent=palavras[pi];palavra.classList.remove('sai')},800)},3500);
// faixa rolante
const frase=['🌱 Plantando a mudança','💧 Protegendo nascentes','🌳 Mata Atlântica viva','📚 Educação ambiental','🤝 Junte-se a nós'].map(t=>`<span class="mx-8">${t}</span>`).join('');
mq.innerHTML=frase+frase;
// cabeçalho e barra de progresso
const hd=document.querySelector('header');
window.addEventListener('scroll',()=>{const y=scrollY,h=document.documentElement.scrollHeight-innerHeight;
 progresso.style.width=(y/h*100)+'%';hd.classList.toggle('scrolled',y>50)});
// entrada escalonada dos cards e princípios
const pronto=el=>el.addEventListener('transitionend',ev=>{if(ev.propertyName==='opacity'&&el.classList.contains('show')){el.style.transitionDelay='0s';el.classList.add('pronto')}});
document.querySelectorAll('.card').forEach((c,i)=>{c.style.transitionDelay=(i%4)*.12+'s';pronto(c)});

document.querySelectorAll('#princ>div').forEach((d,i)=>{d.classList.add('reveal');d.style.transitionDelay=(i%4)*.12+'s';pronto(d);io.observe(d)});
</script>
</body>
</html>