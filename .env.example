# ─────────────────────────────────────────────────────────
# .env.example — copie este arquivo para .env e preencha
# os valores reais. O arquivo .env está no .gitignore.
# ─────────────────────────────────────────────────────────

# EmailJS — https://www.emailjs.com/
# Account → API Keys
EMAILJS_PUBLIC_KEY=sua_public_key_aqui

# Email Services → Service ID
EMAILJS_SERVICE_ID=seu_service_id_aqui

# Email Templates → Template ID
EMAILJS_TEMPLATE_ID=seu_template_id_aqui
